#!/bin/sh
# Fullscreen touch test / calibration.
#
# If --hide-waybar is given, an overlay layer-shell surface (e.g. waybar) is
# hidden for the duration of the app so it does not cover the bottom edge of
# the panel.  By default nothing is hidden, so the app works on any Wayland
# compositor.

set -u

HIDE_WAYBAR=0
for arg in "$@"; do
    case "$arg" in
        --hide-waybar) HIDE_WAYBAR=1 ;;
    esac
done

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export GDK_BACKEND=wayland

DATA_DIR="$HOME/.local/share/touch-test"
mkdir -p "$DATA_DIR"

was_running=0
if [ "$HIDE_WAYBAR" = 1 ] && pgrep -x waybar >/dev/null 2>&1; then
    was_running=1
    pkill -x waybar 2>/dev/null || true
    i=0
    while pgrep -x waybar >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
        sleep 0.1
        i=$((i + 1))
    done
fi

cleanup() {
    if [ "$was_running" = 1 ] && ! pgrep -x waybar >/dev/null 2>&1; then
        nohup waybar >>"$DATA_DIR/waybar.log" 2>&1 &
    fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

python3 "$HOME/.local/bin/touch-test.py" "$@"
